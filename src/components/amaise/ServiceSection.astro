---
const { title, text, image, alt, href, label } = Astro.props;

import ReadMore from "../amaise/ReadMore.astro";
---

<section class="services">
  <img src={image} alt={alt} class="service-img" loading="lazy" />
  <div class="service-content">
    <h4>{title}</h4>
    <p>{text}</p>
    <ReadMore href={href} label={label} />
  </div>
</section>

<style>
  .services {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 2rem;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .services h4,
  .services p {
    margin: 0;
  }

  .services p {
    max-width: 30ch;
  }

  .service-img {
    display: none;
    margin-bottom: 10px;
  }

  @media (min-width: 900px) {
    .services {
      align-items: start;
      text-align: left;
    }

    .service-img {
      display: block;

      width: 100%;
      aspect-ratio: 3 / 4;

      object-fit: cover;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .service-content {
      align-items: flex-start;
    }

    .services p {
    }
  }
</style>
