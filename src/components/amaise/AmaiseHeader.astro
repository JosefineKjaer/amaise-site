---
import BookButton from "./BookButton.astro";
---

<header class="amaise-header">
  <a href="/amaise" class="amaise-logo">
    <img src="/imgs/amaise-logo.webp" alt="A'MAISE logo" />
  </a>
  <div class="header-actions">
    <BookButton />
    <button class="burger">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="amaise-nav">
    <a href="/amaise">Home</a>
    <a href="/amaise/services">Services</a>
    <a href="/amaise/inspiration">Inspiration</a>
    <a href="/amaise/about">About</a>
  </nav>
</header>

<style>
  .amaise-nav a {
    font-family: var(--font-heading);
    font-weight: 200;

    text-transform: uppercase;
    letter-spacing: 0.02em;

    text-decoration: none;
    color: var(--text-light);

    font-size: 1.2rem;
  }

  .amaise-nav a:hover {
    color: var(--secondary);
  }

  .amaise-logo {
    display: flex;
    align-items: center;
  }

  .amaise-logo img {
    width: clamp(110px, 18vw, 130px);
    display: block;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2rem);
    z-index: 20;
  }
  .amaise-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;

    padding: 1rem;
    z-index: 1000;
  }

  .burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;

    z-index: 20;
  }

  .burger span {
    width: 28px;
    height: 2px;
    background-color: white;
    display: block;

    transition: all 0.3s ease;
  }

  .burger.active span:nth-child(1) {
    transform: rotate(45deg) translateY(10px);
  }
  .burger.active span:nth-child(2) {
    opacity: 0;
  }
  .burger.active span:nth-child(3) {
    transform: rotate(-45deg) translateY(-10px);
  }

  .amaise-nav {
    position: fixed;
    top: 0;
    right: 0;

    width: 50vw;
    height: 100vh;

    background: var(--text-dark);
    padding: 6rem 2rem;

    display: flex;
    flex-direction: column;
    gap: 2rem;
    transform: translateX(100%);
    transition: transform 0.3s ease;

    z-index: 10;
  }

  .amaise-nav.active {
    transform: translate(0);
  }

  @media (min-width: 900px) {
    .burger {
      display: none;
    }

    .amaise-nav {
      position: static;
      transform: translateX(0);

      width: auto;
      height: auto;
      background: none;
      padding: 0;

      flex-direction: row;
      align-items: center;

      gap: clamp(2rem, 4vw, 4rem);

      justify-self: end;
      margin-right: 2rem;
    }

    .amaise-header {
      padding: 1rem 2rem;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }

    .header-actions {
      order: 3;
    }
  }
</style>

<script>
  const burger = document.querySelector(".burger");
  const nav = document.querySelector(".amaise-nav");

  burger?.addEventListener("click", () => {
    nav?.classList.toggle("active");
    burger.classList.toggle("active");
  });
</script>
