---
import BookButton from "./BookButton.astro";
---

<footer class="footer-grid">
  <div class="ready">
    <h3>Ready to take care of your hair?</h3>
    <BookButton />
  </div>

  <div class="location">
    <h4>Location</h4>
    <a href="https://maps.app.goo.gl/E7KhDX6AV7n9qFzr9" target="_blank">Nørrebrogade 213 st tv, København 2200</a>
  </div>

  <div class="contact">
    <h4>Contact</h4>
    <div>
      <a href="https://www.instagram.com/amaise_comu/" target="_blank"> <img src="/imgs/dm.webp" alt="instagram DM symbol" /></a>

      <a href="mailto:amaise.ceo@gmail.com" target="_blank"><img src="/imgs/mail.webp" alt="mail symbol" /></a>
    </div>
  </div>

  <div class="some">
    <h4>Social Media</h4>
    <div>
      <a href="https://www.instagram.com/amaise_comu/" target="_blank"><img src="/imgs/instagram.webp" alt="instagram symbol" /></a>
      <a href="https://www.tiktok.com" target="_blank"><img src="/imgs/tiktok.webp" alt="tiktok symbol" /></a>
    </div>
  </div>

  <div class="opening">
    <h4>Opening hours</h4>
    <p>Opening hours vary. <br /> For daily updates and availability, check Instagram stories.</p>
  </div>
</footer>

<style>
  .footer-grid {
    background: var(--text-dark);
    color: var(--text-light);

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 2.5rem 1.5rem;

    padding: 3rem 1.5rem;

    text-align: center;
  }

  .footer-grid > div {
    display: flex;
    flex-direction: column;
    align-items: center;

    gap: 0.5rem;
  }

  .footer-grid h4 {
    margin: 0;

    font-size: clamp(0.95rem, 2vw, 1.2rem);
  }

  .footer-grid p,
  .footer-grid a {
    margin: 0;

    color: var(--text-light);
    text-decoration: none;

    font-family: var(--font-body);

    font-size: clamp(0.85rem, 2vw, 1rem);

    line-height: 1.2;
  }

  .ready {
    grid-column: 1 / -1;
  }

  .ready h3 {
    font-family: var(--font-heading);

    text-transform: none;
    font-weight: 500;
    font-style: italic;

    max-width: 16ch;

    font-size: clamp(1.2rem, 4vw, 1.5rem);

    margin-bottom: 0.7rem;
  }

  .location a {
    max-width: 18ch;
  }

  .footer-grid img {
    width: clamp(18px, 5vw, 24px);
  }

  .some div,
  .contact div {
    display: flex;
    flex-direction: row;
    gap: 1rem;

    padding-top: 0.5rem;
  }

  /***** DESKTOP *****/

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(5, 1fr);

      /* align-items: center; */

      gap: 3rem;

      padding: 3rem;
    }

    .ready {
      grid-column: auto;
      align-self: start;
    }

    .footer-grid p,
    .footer-grid a {
      font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    }

    .ready h3 {
      font-size: clamp(1.4rem, 2vw, 1.8rem);
      margin: 0 0 0.7rem;
    }
  }
</style>
