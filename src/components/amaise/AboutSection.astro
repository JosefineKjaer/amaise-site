---
import ReadMore from "../amaise/ReadMore.astro";
---

<section class="about">
  <div class="about-card">
    <div class="about-info">
      <h2>About A'MAISE</h2>
      <p>A’MAISE is more than just a hair salon. It’s a warm and welcoming space focused on curls, texture, and making every client feel seen and understood.</p>
      <p class="about-bottom-text">Maise is passionate about creating an experience where quality, comfort, and connection go hand in hand — so you can feel at home from the moment you walk through the door.</p>
      <ReadMore href="/amaise/about.astro" label="Read more about A'MAISE" />
    </div>
    <img src="/imgs/maise.webp" alt="Photo of Maise, founder of A'MAISE" class="about-img" loading="lazy" />
  </div>
</section>

<style>
  .about {
    padding: 5rem 1rem;
  }

  .about-card {
    position: relative;

    max-width: 600px;

    margin: 0 auto;

    background: var(--secondary);

    padding: 2rem 1.5rem 2rem 1.5rem;
    /* overflow: visible; */

    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
  }

  .about-info {
    padding-right: 8rem;
  }

  .about-info h2 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .about-info p {
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .about-img {
    width: 140px;

    aspect-ratio: 3 / 4;
    object-fit: cover;

    position: absolute;

    top: 0.1rem;
    right: -0.1rem;

    transform: rotate(-3deg);
  }

  @media (min-width: 350px) and (max-width: 499px) {
    .about-bottom-text {
      max-width: none;
      margin-right: -8rem;
      padding-top: 1rem;
    }
  }

  @media (min-width: 500px) {
    .about-img {
      width: 150px;
    }
  }

  @media (min-width: 700px) {
    .about-img {
      width: 160px;
    }
  }

  @media (min-width: 900px) {
    .about {
      padding: 8rem 2rem;
    }

    .about-card {
      max-width: 900px;
      margin: 0 auto;
      padding: 4rem;

      display: grid;
      grid-template-columns: 1fr 350px;

      gap: 3rem;

      align-items: center;
    }

    .about-img {
      /* position: absolute; */

      width: 360px;

      right: -0.3rem;
      top: 0.5rem;
    }

    .about-info {
      padding-right: 0;
    }
  }
</style>
