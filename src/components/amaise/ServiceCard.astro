---
const { title, image, alt, text, prices, beforeText } = Astro.props;

import BookButton from "./BookButton.astro";
---

<section class="service-card">
  <div class="service-top">
    <div>
      <h3>{title}</h3>
      {image && <img src={image} alt={alt} loading="lazy" />}
      <p set:html={text} />
    </div>
  </div>

  <div class="service-extra">
    <div>
      <h4>Price & estimated time</h4>
      {
        prices.map((item) => (
          <div class={`price-row ${!item.label ? "single-price" : ""}`}>
            {item.label && (
              <>
                <strong>{item.label}</strong>
                <span />
              </>
            )}

            <p>
              {item.time} / {item.price}
            </p>
          </div>
        ))
      }
      <div class="book">
        <BookButton />
      </div>
    </div>
    {
      beforeText && (
        <div>
          <h4>Before the appointment</h4>
          <p set:html={beforeText} />
        </div>
      )
    }
  </div>

  <button class="card-toggle" type="button" aria-label="Open service card">
    <span class="arrow">﹀</span>
  </button>
</section>

<style>
  .service-card {
    background: var(--secondary);
    color: var(--text-dark);
    width: clamp(320px, 88vw, 700px);
    margin: auto;
    margin-bottom: 2rem;
    padding: 1.4rem;
    text-align: center;
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.16);
  }

  .service-top h3 {
    margin-bottom: 1rem;
  }

  .service-top img {
    width: 80%;
    display: block;
    margin: 1.4rem auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .service-extra {
    max-width: 400px;
    margin: auto;
  }

  .service-extra {
    display: none;
    margin-top: 1.5rem;
  }

  .service-card.is-open .service-extra {
    display: block;
  }

  .price-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    align-items: center;
    margin-bottom: 0.7rem;
  }

  .price-row span {
    height: 1px;
    background: var(--text-dark);
    opacity: 0.5;
  }

  .price-row p {
    margin: 0;
  }

  .single-price {
    display: flex;
    justify-content: center;
  }

  .card-toggle {
    border: 0;
    background: none;
    color: var(--text-dark);
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .card-toggle span {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .service-card.is-open .card-toggle span {
    transform: rotate(180deg);
  }
  @media (min-width: 700px) {
    .service-card {
      position: relative;
      width: min(88vw, 1300px);
      min-height: 430px;

      margin: 4rem auto;
      padding: 3rem clamp(13rem, 22vw, 22rem) 3rem 4rem;
      text-align: left;
    }

    .service-top {
      max-width: 450px;
      margin: 0;
    }

    .service-top h3,
    .service-top h4,
    .service-extra h4 {
      text-align: left;
    }

    .service-top h3 {
      margin: 0 0 1rem;
    }

    .service-top p {
      margin: 0 0 2rem;
    }

    .service-top img {
      position: absolute;
      right: -2rem;
      top: 2rem;

      width: clamp(220px, 24vw, 360px);
      height: clamp(300px, 30vw, 440px);

      margin: 0;
      object-fit: cover;
    }

    .service-top h4 {
      margin: 0 0 1rem;
    }

    .service-extra {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      margin: 2rem 0 0;
      max-width: none;
    }

    .card-toggle {
      display: none;
    }

    .book {
      padding-top: 20px;
      text-align: center;
    }

    .single-price {
      justify-content: left;
    }
  }
</style>
