---
const { title, text, image, alt, href } = Astro.props;
---

<article class="artist-card">
  {image && <img src={image} alt={alt} class="artist-image" />}

  <h3>{title}</h3>
  <p>{text}</p>

  <a href={href} class="button">View stylist</a>
</article>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 1rem 2rem;

    background-color: var(--text-dark);
    color: var(--text-light);
    border-radius: 999px;

    font-size: 0.9rem;
    text-decoration: none;

    transition: 0.3s ease;

    margin-top: auto;
    align-self: flex-start;
  }

  .button:hover {
    padding: 1.1rem 2.1rem;
    font-size: 1rem;
  }

  .artist-card {
    width: min(100%, 320px);
    /* margin: 2rem auto; */

    text-align: left;
    height: 100%;

    display: flex;
    flex-direction: column;

    justify-items: center;
  }

  .artist-card p {
    margin: 0.3rem 0 1rem;
    text-align: left;
  }

  .artist-card h3 {
    margin: 0;
    text-align: left;
  }

  .artist-image {
    width: 100%;
    border-radius: 2rem;
    display: block;
    margin-bottom: 0.5rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
</style>
