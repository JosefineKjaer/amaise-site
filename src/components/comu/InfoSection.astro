---
const { title, text, image, alt, href, noBorder = false } = Astro.props;
---

<section class={`info-section ${noBorder ? "no-border" : ""}`}>
  <h2>{title}</h2>
  {text && <p>{text}</p>}

  <a href={href} target="_blank">
    {image && <img src={image} alt={alt} class="info-image" />}
  </a>

  <slot />
</section>

<style>
  .info-section {
    width: calc(100% - 2rem);
    max-width: 900px;
    margin: 3rem auto;
    padding: 1rem 2rem 2rem;
    border: 3px solid var(--text-dark);
    border-radius: 7rem;
    text-align: center;
  }

  .info-section.no-border {
    border: none;
  }

  .info-image {
    margin: 2rem auto 0;
    border-radius: 2rem;
    width: min(100%, 100px);
  }

  @media (min-width: 900px) {
    .info-section {
      max-width: 1100px;
      padding: 2rem 4rem 3rem;
    }

    .info-image {
      width: min(100%, 150px);
    }
  }
</style>
