---
import AmaiseLayout from "../../layouts/AmaiseLayout.astro";
const images = [
  {
    before: "/imgs/before1.webp",
    after: "/imgs/after1.webp",
    alt: "Short hair, tight curl pattern almost coily",
  },
  {
    before: "/imgs/before2.webp",
    after: "/imgs/after2.webp",
    alt: "Short hair, medium tight curl pattern",
  },
  {
    before: "/imgs/before3.webp",
    after: "/imgs/after3.webp",
    alt: "Short hair, loose curl pattern",
  },
  {
    before: "/imgs/before4.webp",
    after: "/imgs/after4.webp",
    alt: "Long hair, tight curl pattern",
  },
  {
    before: "/imgs/before5.webp",
    after: "/imgs/after5.webp",
    alt: "Curly hair transformation",
  },
  {
    before: "/imgs/before6.webp",
    after: "/imgs/after6.webp",
    alt: "Short hair, loose curl pattern",
  },
  {
    before: "/imgs/before7.webp",
    after: "/imgs/after7.webp",
    alt: "Short hair, tight curl pattern, dyed blonde",
  },
  {
    before: "/imgs/before8.webp",
    after: "/imgs/after8.webp",
    alt: "Long hair, tight curl pattern, dyed blonde",
  },
  {
    before: "/imgs/before9.webp",
    after: "/imgs/after9.webp",
    alt: "Medium length hair, tight curl pattern, dyed blonde",
  },
  {
    before: "/imgs/before11.webp",
    after: "/imgs/after11.webp",
    alt: "Long hair, loose curl pattern",
  },
  {
    before: "/imgs/before12.webp",
    after: "/imgs/after12.webp",
    alt: "Medium length hair, medium tight curl pattern, dyed red",
  },
  {
    before: "/imgs/before13.webp",
    after: "/imgs/after13.webp",
    alt: "Short hair, loose curl pattern",
  },
  {
    before: "/imgs/before14.webp",
    after: "/imgs/after14.webp",
    alt: "Medium length hair, medium loose curl pattern",
  },
  {
    before: "/imgs/before15.webp",
    after: "/imgs/after15.webp",
    alt: "Short hair, tight curl pattern, dyed honey brown",
  },
  {
    before: "/imgs/before16.webp",
    after: "/imgs/after16.webp",
    alt: "Medium length hair, tight curl pattern",
  },
  {
    before: "/imgs/before17.webp",
    after: "/imgs/after17.webp",
    alt: "Very short hair, loose curl pattern",
  },
  {
    before: "/imgs/before18.webp",
    after: "/imgs/after18.webp",
    alt: "Long hair, loose curl pattern",
  },
];
---

<AmaiseLayout>
  <section class="inspiration">
    <h1>Inspiration</h1>
    <p class="hover-note">Hover to see before pictures</p>
    <img src="/imgs/arrow.webp" alt="arrow pointing towards images" class="arrow" />
    <div class="mobile-gallery">
      <div class="inspo-col mobile-left">
        {
          [images[0], images[2], images[7], images[10]].map((image) => (
            <article class="inspo-card">
              <img class="after-img" src={image.after} alt={image.alt} loading="lazy" />
              <img class="before-img" src={image.before} alt={image.alt} loading="lazy" />
            </article>
          ))
        }
      </div>

      <div class="inspo-col mobile-right">
        {
          [images[1], images[4], images[8], images[12]].map((image) => (
            <article class="inspo-card">
              <img class="after-img" src={image.after} alt={image.alt} loading="lazy" />
              <img class="before-img" src={image.before} alt={image.alt} loading="lazy" />
            </article>
          ))
        }
      </div>
    </div>

    <div class="desktop-gallery">
      <div class="inspo-col col-1">
        {
          [images[3], images[5], images[13]].map((image) => (
            <article class="inspo-card">
              <img class="after-img" src={image.after} alt={image.alt} loading="lazy" />
              <img class="before-img" src={image.before} alt={image.alt} loading="lazy" />
            </article>
          ))
        }
      </div>

      <div class="inspo-col col-2">
        {
          [images[2], images[0], images[6], images[14]].map((image) => (
            <article class="inspo-card">
              <img class="after-img" src={image.after} alt={image.alt} loading="lazy" />
              <img class="before-img" src={image.before} alt={image.alt} loading="lazy" />
            </article>
          ))
        }
      </div>

      <div class="inspo-col col-3">
        {
          [images[1], images[8], images[15]].map((image) => (
            <article class="inspo-card">
              <img class="after-img" src={image.after} alt={image.alt} loading="lazy" />
              <img class="before-img" src={image.before} alt={image.alt} loading="lazy" />
            </article>
          ))
        }
      </div>

      <div class="inspo-col col-4">
        {
          [images[7], images[9], images[16]].map((image) => (
            <article class="inspo-card">
              <img class="after-img" src={image.after} alt={image.alt} loading="lazy" />
              <img class="before-img" src={image.before} alt={image.alt} loading="lazy" />
            </article>
          ))
        }
      </div>

      <div class="inspo-col col-5">
        {
          [images[10], images[11], images[12]].map((image) => (
            <article class="inspo-card">
              <img class="after-img" src={image.after} alt={image.alt} loading="lazy" />
              <img class="before-img" src={image.before} alt={image.alt} loading="lazy" />
            </article>
          ))
        }
      </div>
    </div>
  </section>
</AmaiseLayout>

<style>
  .inspiration {
    padding: 1rem 1rem 4rem;
  }

  .hover-note,
  .desktop-gallery,
  .arrow {
    display: none;
  }

  .mobile-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    max-width: 420px;
    margin: 0 auto;
    align-items: end;
  }

  .inspo-col {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    justify-content: flex-end;
  }

  .mobile-left {
    padding-top: 3rem;
  }

  .inspo-card {
    position: relative;
    overflow: hidden;
    border-radius: 0.8rem;
  }

  .inspo-card img {
    width: 100%;
    display: block;
  }

  .inspo-card .before-img {
    display: none;
  }

  @media (min-width: 900px) {
    .inspiration {
      padding: 4rem 2rem 8rem;
      position: relative;
    }

    .hover-note {
      display: block;
      text-align: center;
      max-width: clamp(11rem, 17vw, 14rem);
      margin-left: 4rem;
      font-size: clamp(1.2rem, 2vw, 1.5rem);
      font-style: italic;
      /* text-transform: uppercase; */
    }

    .arrow {
      display: block;
      position: absolute;
      width: clamp(10rem, 17vw, 20rem);
      top: clamp(19rem, 8vw, 26rem);
      left: clamp(4rem, 8vw, 9rem);
      transform: translateX(-50%);
    }

    .mobile-gallery {
      display: none;
    }

    .desktop-gallery {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
      max-width: 1400px;
      margin: 0 auto;
      align-items: end;
    }

    .inspo-card .before-img {
      display: block;
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .inspo-card:hover .before-img {
      opacity: 1;
    }
  }

  @media (min-width: 1200px) {
    .arrow {
      top: clamp(25rem, 8vw, 30rem);
      left: clamp(4rem, 8vw, 12rem);
    }
  }
</style>
