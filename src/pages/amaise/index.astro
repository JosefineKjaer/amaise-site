---
import AmaiseLayout from "../../layouts/AmaiseLayout.astro";
import AmaiseHero from "../../components/amaise/AmaiseHero.astro";
import WaveDivider from "../../components/amaise/WaveDivider.astro";
import ServiceSection from "../../components/amaise/ServiceSection.astro";
import AboutSection from "../../components/amaise/AboutSection.astro";
---

<AmaiseLayout>
  <AmaiseHero />

  <section class="service-grid">
    <ServiceSection title="Curly cuts" text="Tailored cuts for curls and textured hair – all about shape, bounce, and definition." image="/imgs/cut.JPG" alt="Curly hair getting cut" />
    <ServiceSection title="Colour" text="Custom colour that suits your vibe – soft, dimensional, and made to last." image="/imgs/color.JPG" alt="Colored curly hair getting styled" />
    <ServiceSection title="Straight hair" text="Clean cuts and treatments for straight hair – simple, polished, and effortless." />
  </section>

  <AboutSection />
</AmaiseLayout>

<style>
  @media (min-width: 700px) {
    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
