---
import AmaiseLayout from "../../layouts/AmaiseLayout.astro";
import AmaiseHero from "../../components/amaise/AmaiseHero.astro";
import ServiceSection from "../../components/amaise/ServiceSection.astro";
import AboutSection from "../../components/amaise/AboutSection.astro";
---

<AmaiseLayout>
  <AmaiseHero />
  <h2>Services</h2>
  <img class="wave" src="/imgs/wave.png" alt="wave vector" />
  <section class="service-grid">
    <ServiceSection href="/amaise/services?category=curls" title="Curly hair" text="Tailored cuts and colour for curls and textured hair — all about shape, bounce, and definition." image="/imgs/cut.JPG" alt="Curly hair getting cut" />
    <ServiceSection href="/amaise/services?category=straight" title="Straight hair" text="Tailored cuts and colour for straight hair — focused on movement, softness, and effortless styling." image="/imgs/stock-img.png" alt="Image is on the way" />
    <ServiceSection href="/amaise/services?category=brow-lash" title="Brow & lash colour" text="Tailored cuts for curls and textured hair – all about shape, bounce, and definition." image="/imgs/stock-img.png" alt="Image is on the way" />
  </section>
  <img class="wave2" src="/imgs/wave.png" alt="wave vector" />
  <AboutSection />
</AmaiseLayout>

<style>
  .wave {
    position: absolute;
    width: 100vw;
    top: 19rem;
  }

  .wave2 {
    position: absolute;
    width: 100vw;
    top: 90rem;
    transform: scaleX(-1);
  }

  @media (min-width: 700px) {
    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .wave {
      top: 26.5rem;
    }

    .wave2 {
      top: 73rem;
    }
  }

  @media (min-width: 900px) {
    .wave {
      top: 28rem;
      z-index: -1;
    }
    .wave2 {
      top: 115rem;
    }

    h2 {
      z-index: 20;
    }
  }
</style>
