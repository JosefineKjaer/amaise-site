  </div>

  <img class="wave2" src="/imgs/wave.png" alt="wave vector" />
  <img class="wave3" src="/imgs/wave.png" alt="wave vector" />
</AmaiseLayout>

<style>
  .service-h1 {
    padding-top: 3.2rem;
  }
  .service-filters {
    display: flex;
    justify-content: center;
    gap: clamp(0.6rem, 1.5vw, 1.2rem);
    flex-wrap: wrap;
    margin: clamp(1.5rem, 4vw, 4rem) auto;
  }

  .filter-btn {
    border: 1.5px solid var(--text-dark);
    background: var(--secondary);
    color: var(--text-dark);
    padding: clamp(0.6rem, 1vw, 0.9rem) clamp(1rem, 2vw, 2rem);
    border-radius: 999px;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(0.9rem, 1vw, 1.1rem);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .filter-btn:hover {
    transform: translateY(-2px);
  }

  .filter-btn.active {
    background: var(--accent);
    border-color: var(--text-dark);
  }
  .service-item {
    display: none;
  }

  .service-item.is-visible {
    display: block;
  }

  h2 {
    margin-bottom: 1rem;
  }

  .wave {
    position: absolute;
    width: 100vw;
    top: 27rem;
    z-index: -10;
  }

  .wave2 {
    position: absolute;
    width: 100vw;
    top: 200rem;
    transform: scaleX(-1);
    z-index: -10;
  }

  .wave3 {
    position: absolute;
    width: 100vw;
    top: 300rem;
    z-index: -10;
  }

  @media (min-width: 700px) {
    .wave {
      top: 26.5rem;
    }

    .wave2 {
      top: 200rem;
    }

    .wave3 {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .wave {
      top: 27rem;
      z-index: -1;
    }
    .wave2 {
      top: 200rem;
    }
  }
</style>

<script>
  document.querySelectorAll(".service-card").forEach((card) => {
    const button = card.querySelector(".card-toggle");

    button?.addEventListener("click", () => {
      card.classList.toggle("is-open");
    });
  });

  document.querySelectorAll(".category-card").forEach((card) => {
    const button = card.querySelector(".card-toggle");

    button?.addEventListener("click", () => {
      card.classList.toggle("is-open");
    });
  });

  const filterButtons = document.querySelectorAll(".filter-btn");
  const serviceItems = document.querySelectorAll(".service-item");

  function showCategory(category) {
    serviceItems.forEach((item) => {
      item.classList.toggle("is-visible", item.dataset.category === category);
    });

    filterButtons.forEach((button) => {
      button.classList.toggle("active", button.dataset.filter === category);
    });
  }

  const params = new URLSearchParams(window.location.search);

  const categoryFromUrl = params.get("category") || "curls";

  showCategory(categoryFromUrl);
  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      showCategory(button.dataset.filter);
    });
  });
</script>
