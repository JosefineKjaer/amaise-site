    <div class="service-item" data-category="straight">
      <ServiceCard
        title="Straight cut w. wash"
        image="/imgs/stock-img.png"
        alt="Image is on the way <33"
        text="This is for customers seeking a haircut accompanied by a relaxing hair wash."
        prices={[
