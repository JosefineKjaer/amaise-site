---
import AmaiseLayout from "../../layouts/AmaiseLayout.astro";
import ServiceCard from "../../components/amaise/ServiceCard.astro";
import CategoryCard from "../../components/amaise/CategoryCard.astro";
---

<AmaiseLayout>
  <h1 class="service-h1">Services</h1>

  <CategoryCard />

  <div class="service-filters">
    <button class="filter-btn active" data-filter="curls">Curls</button>
    <button class="filter-btn" data-filter="straight">Straight hair</button>
    <button class="filter-btn" data-filter="brow-lash">Brow & lash colour</button>
  </div>

  <img class="wave" src="/imgs/wave.png" alt="wave vector" />

  <div class="service-list">
    <div class="service-item" data-category="curls">
      <ServiceCard
        title="DRY CURLY CUT QUICK"
        image="/imgs/cut.JPG"
        alt="Curly hair getting cut"
        text="This is a quick trim, for you who wants to keep the length. I will only cut your hair in the same shape, that you already have. And the haircut only includes 2-3 centimeters being cut off."
        prices={[
          { label: "Thin & Short", time: "30 min", price: "600 kr" },
          {
            label: "In between",
            time: "40 min",
            price: "600 kr",
          },
          {
            label: "Long and/or thick",
            time: "50 min",
            price: "800 kr",
          },
        ]}
        beforeText="Your hair must be washed and detangled all the way through the knots, on the day before or on the same day as your appointment. Apply the hair products you use at home, so I can see the full potential of your curls. Your hair has to be dry for the best outcome of your haircut. "
      />
    </div>

    <div class="service-item" data-category="curls">
      <ServiceCard
        title="DRY CURLY CUT MORE"
        image="/imgs/cut-more.JPG"
        alt="Curly hair structure before a haircut"
        text="This is for you who needs more than 2-3 centimeters off your length, or if you need a big chop. "
        prices={[
          { label: "Thin & Short", time: "45 min", price: "800 kr" },
          {
            label: "In between",
            time: "60 min",
            price: "900 kr",
          },
          {
            label: "Long and/or thick",
            time: "80 min",
            price: "1100 kr",
          },
        ]}
        beforeText="Make sure to give your hair some care by gently detangling it on the final wash day before your appointment."
      />
    </div>

    <div class="service-item" data-category="curls">
      <ServiceCard
        title="CURLY CUT W. WASH"
        image="/imgs/wash.JPG"
        alt="Curly hair getting washed"
        text="I'll give your hair the treatment it deserves by washing, drying, and styling it just the way it needs."
        prices={[
          { label: "Thin & Short", time: "75 min", price: "1000 kr" },
          {
            label: "In between",
            time: "90 min",
            price: "1250 kr",
          },
          {
            label: "Long and/or thick",
            time: "120 min",
            price: "1650 kr",
          },
        ]}
        beforeText="Make sure to give your hair some care by gently detangling it on the final wash day before your appointment."
      />
    </div>

    <div class="service-item" data-category="curls">
      <ServiceCard
        title="Glossing"
        image="/imgs/glossing.JPG"
        alt=""
        text="It’s not a permanent colour. It lasts for about 1,5 - 3 months.
The glossing can make your hair darker, warmer or colder. BUT NOT blonder."
        prices={[
          { label: "Thin & Short", time: "60 min", price: "800 kr" },
          {
            label: "In between",
            time: "75 min",
            price: "950 kr",
          },
          {
            label: "Long and/or thick",
            time: "90 min",
            price: "1110 kr",
          },
        ]}
        beforeText="Make sure to give your hair some care by gently detangling it on the final wash day before your appointment."
