          },
        ]}
      />
    </div>

    <div class="service-item" data-category="brow-lash">
      <ServiceCard title="Brow colour" image="/imgs/stock-img.png" alt="Image is on the way <33" prices={[{ time: "10 min", price: "200 kr" }]} />
    </div>

    <div class="service-item" data-category="brow-lash">
      <ServiceCard title="Lash colour" image="/imgs/stock-img.png" alt="Image is on the way <33" prices={[{ time: "15 min", price: "220 kr" }]} />
    </div>

    <div class="service-item" data-category="brow-lash">
      <ServiceCard title="Brow & lash colour" image="/imgs/stock-img.png" alt="Image is on the way <33" prices={[{ time: "30 min", price: "400 kr" }]} />
