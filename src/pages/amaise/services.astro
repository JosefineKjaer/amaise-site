            time: "80 min",
            price: "1000 kr",
          },
        ]}
      />
    </div>

    <div class="service-item" data-category="straight">
      <ServiceCard
        title="Faceframe + glossing"
        image="/imgs/stock-img.png"
        alt="Image is on the way <33"
        text="FACEFRAME + GLOSSING is a great way to get a quick mini touch-up for your hair colour, in the form of balayage or highlights.
It's only in the front of your hairline."
        prices={[
          { label: "Short/In between", time: "120 min", price: "1500 kr" },
          {
